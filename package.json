{
  "name": "app-maker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Iranian No-Code SaaS App Maker Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web-builder",
    "dev:server": "npm run dev --workspace=apps/server",
    "build:all": "npm run build --workspaces"
  },
  "keywords": [
    "app-maker",
    "no-code",
    "flutter",
    "server-driven-ui",
    "nextjs",
    "iran"
  ],
  "author": "",
  "license": "ISC"
}
