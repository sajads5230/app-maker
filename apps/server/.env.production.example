# Production PostgreSQL Database Configuration
DATABASE_URL="postgresql://appmaker:appmaker_secure_2026@localhost:5432/appmaker_production?schema=public&connection_limit=25&pool_timeout=15"

# Security & Server
JWT_SECRET="generate_a_super_secure_random_64_character_string_here"
PORT=4000
HOST="0.0.0.0"
NODE_ENV="production"

# Cloud Object Storage (ArvanCloud S3 / MinIO / Liara S3)
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
S3_REGION="default"
S3_BUCKET="appmaker-production-storage"
S3_ACCESS_KEY="your_arvancloud_access_key"
S3_SECRET_KEY="your_arvancloud_secret_key"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_CDN_URL="https://cdn.yourdomain.ir/storage"

# SMS Gateway (KaveNegar / FarazSMS)
KAVENEGAR_API_KEY=""
KAVENEGAR_PATTERN_CODE="otp-login"

# Payment Gateway (ZarinPal / Shaparak)
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"
